# Network settings for code/deploy. Copy to deploy/network.env (git-ignored).
# The remote side probes every endpoint first (bootstrap.sh check) and picks a working route per service.

# auto        : direct if it works, else the proxy below if it works, else the mirrors below
# direct      : no proxy, no mirrors
# http        : everything through HTTP_PROXY_URL (a proxy reachable from the target)
# ssh-reverse : everything through this computer's local proxy, forwarded over SSH (-R); needs
#               AllowTcpForwarding on the target and this computer online while the target downloads/uploads
# mirror      : HF_MIRROR, GITHUB_PROXY, PIP_INDEX_URL, CONDA_MIRROR (downloads only; uploads need a proxy or relay)
PROXY_MODE=auto

HTTP_PROXY_URL=""                         # http mode, e.g. http://10.0.0.5:7890
LOCAL_PROXY_PORT=7890                     # ssh-reverse: port of the proxy on this computer (Clash default 7890)
REMOTE_PROXY_PORT=17890                   # ssh-reverse: port opened on the target

HF_MIRROR=https://hf-mirror.com           # read-only Hugging Face mirror
GITHUB_PROXY=""                           # prefix proxy for github.com, e.g. https://ghfast.top (URL becomes PREFIX/https://github.com/...)
PIP_MIRROR=""                             # e.g. https://pypi.tuna.tsinghua.edu.cn/simple
CONDA_MIRROR=""                           # e.g. https://mirrors.tuna.tsinghua.edu.cn/anaconda/cloud (serves conda-forge)

# Uploads to huggingface.co never use HF_MIRROR. auto = upload from the target when huggingface.co is reachable
# (directly or through the proxy), otherwise keep results on the target for `bootstrap.sh relay-upload`.
UPLOAD_MODE=auto                          # auto | direct | relay
