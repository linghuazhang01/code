# Target machine for code/deploy. Copy to deploy/target.env (git-ignored) and edit the SSH block.
# Everything the scripts install or download goes under REMOTE_ROOT on the target.

# --- SSH (usually the only block that changes) ---
SSH_HOST=203.0.113.10
SSH_USER=ubuntu
SSH_PORT=22
SSH_KEY=~/.ssh/id_ed25519
SSH_EXTRA_OPTS=""                 # e.g. "-o ProxyJump=user@bastion"

# --- Layout on the target ---
REMOTE_ROOT=/data/opd             # code, conda, data, models, outputs and logs all live here
GPU_IDS=0,1,2,3                   # GPUs these scripts may use (training and evaluation)
MIN_FREE_GIB=100                  # stop before writing when free space is below this (CityU H200: 500, AGENTS.md)

# --- Code source ---
CODE_SOURCE=rsync                 # rsync = copy this local checkout (uncommitted changes included); git = clone REPO_URL@REPO_REF
REPO_URL=https://github.com/linghuazhang01/code.git
REPO_REF=main

# --- What to install ---
# The environment is fixed: environment.yml + env.lock.txt = torch 2.6.0, vLLM 0.8.5.post1, transformers 4.51.3
# for both training and evaluation (Blackwell GPUs are refused: torch 2.6 does not support them).
STUDENT_MODELS="Qwen/Qwen3-1.7B Qwen/Qwen3-4B"
TEACHER_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507   # empty = skip (evaluation-only machine)
INSTALL_TRAIN_DATA=1              # DeepMath level-6 + Eurus code parquet (icemoon28/MOPD-Training-Data)
INSTALL_EVAL=1                    # G-OPD eval data, LiveCodeBench v5/v6, pinned EvalPlus runtime
EVAL_CHECKPOINTS=""               # names from deploy/eval_models.tsv to download now, e.g. "q1p7b_math_termlook q1p7b_code_termlook"

# --- Evaluation ---
EVAL_GPU_MEMORY=0.90              # vLLM gpu_memory_utilization per evaluation queue (one queue per GPU)
EVAL_HW_TAG=auto                  # suite tag hardware label; auto = from the GPU name (a100, h200, ...)
EVAL_DATE_TAG=20261023            # protocol tag kept in suite names (same protocol as the A100 tables)

# --- Upload of evaluation results (optional) ---
RESULTS_REPO=""                   # e.g. icemoon28/opd-eval-results (dataset repo); empty = do not upload
RESULTS_REPO_TYPE=dataset
RESULTS_PREFIX=eval_results
